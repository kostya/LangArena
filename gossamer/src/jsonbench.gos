use std::math
use std::encoding::json
use bench::Bench
use config::Config
use helper

type OptsMap = Map<String, (i64, bool)>

struct Coordinate {
    x: f64
    y: f64
    z: f64
    name: String
    opts: OptsMap
}

struct JsonData {
    coordinates: Vec<Coordinate>
    info: String
}

pub struct JsonGenerate {
    n: i64
    text: String
    data: JsonData
    result: u32
    rng: helper::Rng
}

impl JsonGenerate {
    pub fn new(cfg: Config) -> JsonGenerate { JsonGenerate::with_n(cfg.int("Json::Generate", "coords")) }

    fn with_n(n: i64) -> JsonGenerate {
        JsonGenerate {
            n: n
            text: ""
            data: JsonData { coordinates: #[], info: "some info" }
            result: 0
            rng: helper::Rng::new()
        }
    }

    fn round_to_8(value: f64) -> f64 { math::round(value * 100_000_000.0) / 100_000_000.0 }

    pub fn get_result(&self) -> String { self.text }
}

impl Bench for JsonGenerate {
    fn prepare(&mut self) {
        let mut data: Vec<Coordinate> = #[]
        for _ in 0..self.n {
            let x = JsonGenerate::round_to_8(self.rng.next_float(1.0))
            let y = JsonGenerate::round_to_8(self.rng.next_float(1.0))
            let z = JsonGenerate::round_to_8(self.rng.next_float(1.0))

            let name = f"{self.rng.next_float(1.0):.7} {self.rng.next_int(10_000)}"

            let mut opts: OptsMap = Map::new()
            opts.insert("1", (1, true))

            data.push(Coordinate { x: x, y: y, z: z, name: name, opts: opts })
        }
        let json_data = JsonData { coordinates: data, info: "some info" }
        self.data = json_data
    }

    fn run(&mut self, iteration_id: i64) {
        self.text = json::encode(self.data)
        if self.text.starts_with("{\"coordinates\":") { self.result += 1 }
    }

    fn checksum(&self) -> u32 { self.result }
}

pub struct JsonParseDom {
    n: i64
    text: String
    result: u32
}

impl JsonParseDom {
    pub fn new(cfg: Config) -> JsonParseDom {
        JsonParseDom { n: cfg.int("Json::ParseDom", "coords"), text: "", result: 0 }
    }

    fn calc(&self, text: String) -> (f64, f64, f64) {
        let document = json::parse(text).unwrap()
        let coordinates = json::get(document, "coordinates").and_then(json::as_array).unwrap()
        let len = coordinates.len() as f64

        let mut x = 0.0
        let mut y = 0.0
        let mut z = 0.0

        for coord in coordinates {
            x += json::get(coord, "x").and_then(json::as_f64).unwrap()
            y += json::get(coord, "y").and_then(json::as_f64).unwrap()
            z += json::get(coord, "z").and_then(json::as_f64).unwrap()
        }

        (x / len, y / len, z / len)
    }
}

impl Bench for JsonParseDom {
    fn prepare(&mut self) {
        let mut generator = JsonGenerate::with_n(self.n)
        generator.prepare()
        generator.run(0)
        self.text = generator.get_result()
    }

    fn run(&mut self, iteration_id: i64) {
        let x, y, z = self.calc(self.text)
        self.result +%= helper::checksum_f64(x) +% helper::checksum_f64(y) +% helper::checksum_f64(z)
    }

    fn checksum(&self) -> u32 { self.result }
}

struct CoordinateData {
    x: f64
    y: f64
    z: f64
}

struct Coordinates {
    coordinates: Vec<CoordinateData>
}

pub struct JsonParseMapping {
    n: i64
    text: String
    result: u32
}

impl JsonParseMapping {
    pub fn new(cfg: Config) -> JsonParseMapping {
        JsonParseMapping { n: cfg.int("Json::ParseMapping", "coords"), text: "", result: 0 }
    }

    fn calc(&self, text: String) -> CoordinateData {
        let data = json::decode::<Coordinates>(text).unwrap()
        let len = data.coordinates.len() as f64

        let mut x = 0.0
        let mut y = 0.0
        let mut z = 0.0

        for coord in data.coordinates {
            x += coord.x
            y += coord.y
            z += coord.z
        }

        CoordinateData { x: x / len, y: y / len, z: z / len }
    }
}

impl Bench for JsonParseMapping {
    fn prepare(&mut self) {
        let mut generator = JsonGenerate::with_n(self.n)
        generator.prepare()
        generator.run(0)
        self.text = generator.get_result()
    }

    fn run(&mut self, iteration_id: i64) {
        let avg = self.calc(self.text)
        self.result +%= helper::checksum_f64(avg.x) +% helper::checksum_f64(avg.y) +%
            helper::checksum_f64(avg.z)
    }

    fn checksum(&self) -> u32 { self.result }
}
