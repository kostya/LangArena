package csvbench;
import core$;
import math$;
import arena$;
type State = #struct {
  rows Int;
  text String;
  result Int;
  rng Rng;
}

State(cfg Config, name String) => init {
  rows=cfg:integer(name, "rows");
  text=String("");
  result=Int(0);
  rng=Rng();
}

Unit prepare(this State) mut {
  out Buffer=buffer(Int(0), Int(0));
  i Int=Int(0);
  i!to(this.rows-1) {
    x Float=this.rng!nextFloat();
    z Float=this.rng!nextFloat();
    y Float=this.rng!nextFloat();
    truth String=String("true");
    if(rem(i, Int(2))~=0) {
      truth=String("false");
    }
    out!append("\"point "+character(Int(65)+rem(i, Int(26)))+character(Int(92))+"n, \"\""+String(rem(i, Int(100)))+"\"\"\","+fixed(x, Int(10))+",,"+fixed(z, Int(10))+",\"["+truth+character(Int(92))+"n, "+String(rem(i, Int(100)))+"]\","+fixed(y, Int(10))+"\n");
  }
  this.text=out:string();
  return Unit();
}

// As Goose's port reads with its std `csv::each_record` and `parse_flt`:
// one pass over the bytes finds each field, a quote toggling whether a
// separator ends it, and fields 1, 3 and 5 (from 0) are parsed where they
// lie, each row's x, y and z pushed in turn. A row that is not six fields
// or a field that spells no number gives no points.
// As Goose's port reads with its std `csv::each_record` and `parse_flt`:
// one pass over the bytes finds each field, a quote toggling whether a
// separator ends it, and fields 1, 3 and 5 (from 0) are parsed where they
// lie, each row's x, y and z pushed in turn. A row that is not six fields
// or a field that spells no number gives no points.
List<Float> points(text String) {
  out List<Float> = List(Float);
  n Int=text:byteCount();
  column Int=Int(0);
  start Int=Int(1);
  quoted Int=Int(0);
  x Float=Float(0.0);
  y Float=Float(0.0);
  z Float=Float(0.0);
  i Int=Int(1);
  i!to(n) {
    c U8=text:byteAt(i);
    if(c==34) {
      quoted=Int(1)-quoted;
    }
    if(quoted==0 and (c==44 or c==10)) {
      if(column==1) {
        v Float=text:parseFloat(start, i-start) ? e {
          return List(Float);
        }
        x=v;
      }
      if(column==3) {
        v Float=text:parseFloat(start, i-start) ? e {
          return List(Float);
        }
        z=v;
      }
      if(column==5) {
        v Float=text:parseFloat(start, i-start) ? e {
          return List(Float);
        }
        y=v;
      }
      column=column+1;
      start=i+1;
      if(c==10) {
        if(column~=6) {
          return List(Float);
        }
        out!push(x);
        out!push(y);
        out!push(z);
        column=Int(0);
      }
    }
  }
  // A last row with no line break after it.
  if(column==5 and quoted==0) {
    v Float=text:parseFloat(start, n+1-start) ? e {
      return List(Float);
    }
    out!push(x);
    out!push(v);
    out!push(z);
    column=Int(0);
    start=n+1;
  }
  if(column~=0 or quoted~=0 or start<=n) {
    return List(Float);
  }
  return out;
}

Unit step(this State, iteration Int) mut {
  values List<Float> = points(this.text);
  count Int=values:size()/3;
  if(count==0) {
    return Unit();
  }
  x Float=Float(0.0);
  y Float=Float(0.0);
  z Float=Float(0.0);
  i Int=Int(0);
  i!to(count-1) {
    x=x+values[i*3+1];
    y=y+values[i*3+2];
    z=z+values[i*3+3];
  }
  n Float=Float(count);
  this.result=u32(this.result+hashFloat(x/n)+hashFloat(y/n)+hashFloat(z/n));
  return Unit();
}

Int checksum(this State) => u32(this.result+hash(this.text));
Unit resetRandom(this State) mut {
  return Unit();
}

Result execute(this Host, cfg Config, name String) mut {
  state State=State(cfg, name);
  state!prepare();
  iterations Int=cfg:integer(name, "iterations");
  warm Int=max(Int(1), iterations/5);
  if(cfg:has(name, "warmup_iterations")) {
    warm=cfg:integer(name, "warmup_iterations");
  }
  i Int=Int(0);
  i!to(warm-1) {
    state!step(i);
  }
  state!resetRandom();
  started Int=this!start(name);
  j Int=Int(0);
  j!to(iterations-1) {
    state!step(j);
  }
  elapsed Int=this!stop(started);
  actual Int=u32(state:checksum());
  expected Int=u32(cfg:integer(name, "checksum"));
  nanos Int=this!finish(elapsed, actual, expected);
  failed Int=Int(0);
  if(actual~=expected) {
    failed=Int(1);
  }
  return Result(nanos, failed);
}
