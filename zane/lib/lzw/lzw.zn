package lzw;
import core$;
import math$;
import arena$;
import codec$;
type Encoded = struct {
  data String;
}

Encoded(data String) => init {
  data;
}

// As Goose's port: every string is a range of one byte list, made by
// appending its bytes there, and the dictionary is keyed by those ranges.
Encoded encode(input String) {
  n Int=input:byteCount();
  if(n==0) {
    return Encoded(String(""));
  }
  strings List<U8> = List(U8);
  dict BytesMap=BytesMap(min(n*2+1024, Int(65536)*2));
  i Int=Int(0);
  i!to(Int(255)) {
    strings!push(U8.wrap(i));
    dict!put(strings, i+1, Int(1), i);
  }
  next Int=Int(256);
  out List<U8> = List(U8);
  currentStart Int=strings:size()+1;
  currentLength Int=Int(1);
  strings!push(input:byteAt(Int(1)));
  j Int=Int(2);
  j!to(n) {
    b U8=input:byteAt(j);
    charStart Int=strings:size()+1;
    strings!push(b);
    combinedStart Int=strings:size()+1;
    strings!appendOwn(currentStart, currentLength);
    strings!push(b);
    combinedLength Int=currentLength+1;
    found Bool=if(dict:find(strings, combinedStart, combinedLength)>=0) {
      currentStart=combinedStart;
      currentLength=combinedLength;
    }
    found:else() {
      code Int=dict:find(strings, currentStart, currentLength);
      out!push(U8.wrap(shiftRightLogical(code, Int(8))));
      out!push(U8.wrap(bitAnd(code, Int(255))));
      if(next<65536) {
        dict!put(strings, combinedStart, combinedLength, next);
        next=next+1;
      }
      currentStart=charStart;
      currentLength=Int(1);
    }
  }
  code Int=dict:find(strings, currentStart, currentLength);
  out!push(U8.wrap(shiftRightLogical(code, Int(8))));
  out!push(U8.wrap(bitAnd(code, Int(255))));
  return Encoded(String(out));
}

// The decoded bytes, as Goose's port gives them back: a byte list, which
// is a String only where one is compared.
List<U8> decode(encoded Encoded) {
  input String=encoded.data;
  n Int=input:byteCount();
  if(n==0) {
    return List(U8);
  }
  // As in Goose's port, every entry's bytes are in one list, and an entry
  // is where its bytes start there and how many there are.
  strings List<U8> = List(U8);
  starts List<Int> = List(Int);
  lengths List<Int> = List(Int);
  i Int=Int(0);
  i!to(Int(255)) {
    strings!push(U8.wrap(i));
    starts!push(i+1);
    lengths!push(Int(1));
  }
  // Codes are 0-based and the dictionary 1-based.
  old Int=Int(input:byteAt(Int(1)))*256+Int(input:byteAt(Int(2)));
  out List<U8> = List(U8);
  out!push(strings[starts[old+1]]);
  position Int=Int(3);
  j Int=Int(1);
  j!to(n/2-1) {
    next Int=Int(input:byteAt(position))*256+Int(input:byteAt(position+1));
    position=position+2;
    size Int=starts:size();
    if(next>size) {
      return List(U8);
    }
    oldStart Int=starts[old+1];
    oldLength Int=lengths[old+1];
    // The new entry is the previous one and the first byte of this one,
    // which is the previous one's own first byte when this is the entry
    // being made.
    firstAt Int=oldStart;
    if(next<size) {
      firstAt=starts[next+1];
    }
    first U8=strings[firstAt];
    if(size<65536) {
      starts!push(strings:size()+1);
      lengths!push(oldLength+1);
      strings!appendOwn(oldStart, oldLength);
      strings!push(first);
    }
    if(next>=starts:size()) {
      return List(U8);
    }
    out!appendRange(strings, starts[next+1], lengths[next+1]);
    old=next;
  }
  return out;
}

type State = #struct {
  n Int;
  data String;
  encoded Encoded;
  decoded List<U8>;
  result Int;
  decode Bool;
}

State(cfg Config, name String) => init {
  n=cfg:integer(name, "size");
  data=String("");
  encoded=Encoded(String(""));
  decoded=List(U8);
  result=Int(0);
  decode=name=="Compress::LZWDecode";
}

Unit prepare(this State) mut {
  this.data=testData(this.n);
  if(this.decode) {
    this.encoded=encode(this.data);
  }
  return Unit();
}

Unit step(this State, iteration Int) mut {
  mode Bool=if(this.decode) {
    this.decoded=decode(this.encoded);
    this.result=u32(this.result+this.decoded:size());
  }
  mode:else() {
    this.encoded=encode(this.data);
    this.result=u32(this.result+length(this.encoded.data));
  }
  return Unit();
}

Int checksum(this State) {
  if(this.decode and String(this.decoded)==this.data) {
    return u32(this.result+100000);
  }
  return this.result;
}

Unit resetRandom(this State) mut {
  return Unit();
}

Result execute(this Host, cfg Config, name String) mut {
  state State=State(cfg, name);
  state!prepare();
  iterations Int=cfg:integer(name, "iterations");
  warm Int=max(Int(1), iterations/5);
  if(cfg:has(name, "warmup_iterations")) {
    warm=cfg:integer(name, "warmup_iterations");
  }
  i Int=Int(0);
  i!to(warm-1) {
    state!step(i);
  }
  state!resetRandom();
  started Int=this!start(name);
  j Int=Int(0);
  j!to(iterations-1) {
    state!step(j);
  }
  elapsed Int=this!stop(started);
  actual Int=u32(state:checksum());
  expected Int=u32(cfg:integer(name, "checksum"));
  nanos Int=this!finish(elapsed, actual, expected);
  failed Int=Int(0);
  if(actual~=expected) {
    failed=Int(1);
  }
  return Result(nanos, failed);
}
