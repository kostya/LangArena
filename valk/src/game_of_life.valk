struct GolCell {
    alive: bool (false)
    next_state: bool (false)
    neighbors: [Link[GolCell] x 8]
}

// The cells row after row in one arena; a cell names its neighbors with links
class GolGrid {
    width: uint
    height: uint
    cells: Arena[GolCell]

    static fn new(width: uint, height: uint) GolGrid {
        let cells = Arena[GolCell].new(width * height)
        let first = cells.next_link()
        each 0 .. width * height : cells.add(GolCell { neighbors: { first, first, first, first, first, first, first, first } })
        let grid = GolGrid { width: width, height: height, cells: cells }
        grid.link_neighbors()
        return grid
    }

    fn link(y: uint, x: uint) Link[GolCell] {
        return this.cells.link(y * this.width + x)
    }

    fn link_neighbors() {
        let cells = this.cells.view()
        let h = this.height.to(i32)
        let w = this.width.to(i32)
        each 0 .. h as y {
            each 0 .. w as x {
                let cell = cells.ref(this.link(y.to(uint), x.to(uint)))
                let n: uint = 0
                each -1 .. 3 as dy {
                    each -1 .. 3 as dx {
                        if dx == 0 && dy == 0 : continue
                        let ny = ((y + dy + h) % h).to(uint)
                        let nx = ((x + dx + w) % w).to(uint)
                        cell.neighbors[n++] = this.link(ny, nx)
                    }
                }
            }
        }
    }

    fn next_generation() {
        let cells = this.cells.view()
        let all = cells.slice()
        each 0 .. all.length as i {
            let cell = &all[i]
            let alive_neighbors: uint = 0
            each cell.neighbors as n {
                if cells.ref(n).alive : alive_neighbors++
            }
            cell.next_state = cell.alive ? (alive_neighbors == 2 || alive_neighbors == 3) : alive_neighbors == 3
        }

        each 0 .. all.length as i {
            let cell = &all[i]
            cell.alive = cell.next_state
        }
    }

    fn count_alive() u32 {
        let count: u32 = 0
        each this.cells.view().slice() as cell {
            if cell.alive : count++
        }
        return count
    }

    fn compute_hash() u32 {
        let hash: u32 = 2166136261
        each this.cells.view().slice() as cell {
            let alive: u32 = cell.alive ? 1 : 0
            hash = (hash ^ alive) * 16777619
        }
        return hash
    }
}

class GameOfLife is Benchmark {
    grid: GolGrid

    static fn new() SELF {
        let width = config_int("Etc::GameOfLife", "w").to(uint)
        let height = config_int("Etc::GameOfLife", "h").to(uint)
        return SELF { grid: GolGrid.new(width, height) }
    }

    fn name() String {
        return "Etc::GameOfLife"
    }

    fn prepare() {
        let cells = this.grid.cells.view()
        each 0 .. this.grid.height as y {
            each 0 .. this.grid.width as x {
                if next_float(1.0) < 0.1 : cells.ref(this.grid.link(y, x)).alive = true
            }
        }
    }

    fn run(iteration: int) {
        this.grid.next_generation()
    }

    fn checksum() u32 {
        let alive = this.grid.count_alive()
        return this.grid.compute_hash() + alive
    }
}
